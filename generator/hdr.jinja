int num_drv,
{% if conf["has-secondary-task"] %}double eps,
{% if conf["inverse"] == "damped-least-squares" %}double lambda,
{% endif %}{% endif %}const double *g,
{% if conf["has-secondary-task"] and conf["weight-in-drive-space"] %}const double *{{pltf_vel_w_drv(conf)}},
{% endif %}const double *xd_pltf,
{% if conf["has-secondary-task"] and conf["weight-in-platform-space"] %}const double *{{pltf_vel_w_pltf(conf)}},
{% endif %}{% if conf["has-secondary-task"] %}const double *xd_drv_ref,
double *xd_drv_prim,
double *xd_drv_scnd
{% else %}double *xd_drv
{% endif %}
{%- endmacro -%}


