{{- pltf_vel_whl_to_pltf_comm(conf) }}
 */
void {{conf.name}}(
{{pltf_vel_whl_to_pltf_sig(conf) | indent(width=8, first=true)}});
{% endmacro -%}




{%- macro comm_drive_velocity_out(conf) -%}
@param[out] xd_drv The matrix @f$\dot{\vect{X}}_d@f$ with two rows and
                   @p num_drv columns where the rows represent the linear
                   velocity components of each drive. The velocities'
                   reference point is the origin of the individual drives'
                   pivot frames and the coordinates are expressed in these
                   pivot frames. The matrix is arranged as @f[
                   \begin{bmatrix}
                     \dot{X}_{1,x} & \ldots & \dot{X}_{n,x} \\
                     \dot{X}_{1,y} & \ldots & \dot{X}_{n,y}
                   \end{bmatrix}
                   @f] and will be provided in column-major order.
{%- endmacro -%}


{%- macro comm_drive_velocity_reference(conf) -%}
@param[in] xd_drv_ref The matrix @f$\dot{\bar{\vect{X}}}_d@f$ with two rows and
                      @p num_drv columns where the rows represent the linear
                      velocity reference components that are projected into the
                      nullspace of the platform task. The velocities'
                      coordinates are expressed in the individual drives'
                      pivot frames. The matrix is arranged as @f[
                      \begin{bmatrix}
                        \dot{\bar{X}}_{1,x} & \ldots & \dot{\bar{X}}_{n,x} \\
                        \dot{\bar{X}}_{1,y} & \ldots & \dot{\bar{X}}_{n,y}
                      \end{bmatrix}
                      @f] and will be provided in column-major order.
{%- endmacro -%}


{%- macro comm_drive_velocity_primary(conf) -%}
@param[out] xd_drv_prim The matrix @f$\dot{\vect{X}}_{prim}@f$ with two rows
                        and @p num_drv columns that represents the primary-task
                        drive velocities resulting from distributing the
                        platform-level velocity @p xd_pltf. The matrix is
                        arranged the same as @p xd_drv_ref and will be provided
                        in column-major order.
{%- endmacro -%}


{%- macro comm_drive_velocity_secondary(conf) -%}
@param[out] xd_drv_scnd The matrix @f$\dot{\vect{X}}_{scnd}@f$ with two rows
                        and @p num_drv columns that represents the part of
                        @p xd_drv_ref projected into the nullspace of the
                        platform-level task. The matrix is arranged the same
                        as @p xd_drv_ref and will be provided in column-major
                        order. The combined drive velocity is
                        @f$\dot{\vect{X}}_d =
                        \dot{\vect{X}}_{prim} +
                        \dot{\vect{X}}_{scnd}@f$.
{%- endmacro -%}


{%- macro comm_wheel_velocity_out(conf) -%}
@param[out] omega_hub The matrix with two rows and @p num_drv columns where the
                      rows contain the angular velocity around the right and
                      left wheel axle, respectively. The matrix is arranged in
                      column-major order.
{%- endmacro -%}


{%- macro comm_pivot_align_out(conf) -%}
@param[out] q_pvt_algn An array with @p num_drv elements that represent the
                       pivot alignment distance, i.e. the angle by which each
                       pivot must be steered so that its drive rolls without
                       lateral scrubbing for the commanded platform twist.
{%- endmacro -%}


{%- macro comm_platform_velocity_in(conf) -%}
@param[in] xd_pltf The vector @f$\dot{\vect{X}}_p@f$ with three elements
                   that represent the linear and angular velocity of the
                   platform. The linear velocity's reference point is the
                   platform's origin. The coordinates are expressed in the
                   platform frame. The vector is arranged as @f$
                   \begin{bmatrix}
                     v_{p,x} & v_{p,y} & \omega_p
                   \end{bmatrix}@f$.
{%- endmacro -%}


{%- macro comm_platform_velocity_eff_out(conf) -%}
@param[out] xd_pltf_eff The vector @f$\dot{\vect{X}}_{eff}@f$ with three
                        elements that represent the effective linear and
                        angular velocity of the platform, i.e. after the
                        castor alignment has relaxed and the hub speed limit
                        has scaled the commanded twist. The vector is
                        arranged in the same way as @p xd_pltf.
{%- endmacro -%}


{%- macro comm_weight_platform_algn(conf) -%}
@param[in] w_pltf The platform's tracking weight matrix @f$\vect{W}_p@f$, a
                  positive-definite @f$3 \times 3@f$ matrix. The weight is
                  measured in the platform's origin and its coordinates are
                  expressed in the platform frame. The matrix is arranged as
                  @f[
                  \begin{bmatrix}
                    w_{p,xx} & w_{p,yx} & w_{p,mx} \\
                    w_{p,xy} & w_{p,yy} & w_{p,my} \\
                    w_{p,xm} & w_{p,ym} & w_{p,mm}
                  \end{bmatrix}
                  @f] where @f$w_{p,yx} = w_{p,xy}@f$,
                  @f$w_{p,mx} = w_{p,xm}@f$ and @f$w_{p,my} = w_{p,ym}@f$.
                  The ratio between this weight and the alignment weights
                  determines how much platform velocity is given up to align
                  the castors.
{%- endmacro -%}


{%- macro comm_weight_align(conf) -%}
@param[in] w_algn An array with @p num_drv elements that represent a
                  non-negative weight @f$w_{a,i}@f$ for each drive's castor
                  alignment task. The array is arranged as @f$
                  \begin{bmatrix}
                    w_{a,1} & \ldots & w_{a,n}
                  \end{bmatrix}@f$.
{%- endmacro -%}


{%- macro comm_align_time_constant(conf) -%}
@param[in] tau The time constant @f$\tau@f$ within which to remove the
               drives' scrub angle. The time constant must be positive.
{%- endmacro -%}


{%- macro comm_align_max_rate(conf) -%}
@param[in] qd_max The maximum castor rate @f$\dot{q}_{max}@f$ with respect to
                  the platform. The rate must be non-negative.
{%- endmacro -%}


{%- macro comm_hub_velocity_max(conf) -%}
@param[in] omega_max The maximum admissible hub speed @f$\omega_{max}@f$. The
                     speed must be positive.
{%- endmacro -%}


{%- macro pltf_vel_pltf_to_drv_comm(conf) %}
 * {{comm_number_of_drives(conf) | replace("\n", "\n * ")}}
{% if conf["has-secondary-task"] %} * {{comm_eps(conf) | replace("\n", "\n * ")}}
{% if conf["inverse"] == "damped-least-squares" %} * {{comm_lambda(conf) | replace("\n", "\n * ")}}
{% endif %}
{% endif %}
 * {{comm_force_composition_matrix(conf) | replace("\n", "\n * ")}}
{% if conf["has-secondary-task"] and conf["weight-in-drive-space"] %} * {{comm_weight_drive_vel(conf) | replace("\n", "\n * ")}}
{% endif %}
 * {{comm_platform_velocity_in(conf) | replace("\n", "\n * ")}}
{% if conf["has-secondary-task"] and conf["weight-in-platform-space"] %} * {{comm_weight_platform_vel(conf) | replace("\n", "\n * ")}}
{% endif %}
{% if conf["has-secondary-task"] %}
 * {{comm_drive_velocity_reference(conf) | replace("\n", "\n * ")}}
 * {{comm_drive_velocity_primary(conf) | replace("\n", "\n * ")}}
 * {{comm_drive_velocity_secondary(conf) | replace("\n", "\n * ")}}
{% else %} * {{comm_drive_velocity_out(conf) | replace("\n", "\n * ")}}
{% endif %}
{%- endmacro -%}


{%- macro pltf_vel_pltf_to_whl_comm(conf) %}
 * {{comm_number_of_drives(conf) | replace("\n", "\n * ")}}
 * {{comm_force_composition_matrix(conf) | replace("\n", "\n * ")}}
 * {{comm_wheel_geometry(conf) | replace("\n", "\n * ")}}
{% if conf["alignment"]|default("none") == "twist-relaxation" %} * {{comm_weight_platform_algn(conf) | replace("\n", "\n * ")}}
 * {{comm_weight_align(conf) | replace("\n", "\n * ")}}
 * {{comm_align_time_constant(conf) | replace("\n", "\n * ")}}
 * {{comm_align_max_rate(conf) | replace("\n", "\n * ")}}
{% endif %}{% if conf["wheel-speed-limit"]|default(false) %} * {{comm_hub_velocity_max(conf) | replace("\n", "\n * ")}}
{% endif %}
 * {{comm_platform_velocity_in(conf) | replace("\n", "\n * ")}}
{% if conf["alignment"]|default("none") == "twist-relaxation" or conf["wheel-speed-limit"]|default(false) %} * {{comm_platform_velocity_eff_out(conf) | replace("\n", "\n * ")}}
{% endif %} * {{comm_drive_velocity_out(conf) | replace("\n", "\n * ")}}
 * {{comm_wheel_velocity_out(conf) | replace("\n", "\n * ")}}
{%- endmacro -%}


