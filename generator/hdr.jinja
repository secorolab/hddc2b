{%- macro comm_weight_platform_vel(conf) %}
{%- if (conf["preprocess-platform-weight"]) -%}
@param[in] w_pltf The platform's weight matrix @f$\vect{W}_p@f$, a
                  positive-definite @f$3 \times 3@f$ matrix. The weight is
