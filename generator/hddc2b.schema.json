{
    "license": "https://github.com/aws/mit-0",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/product.schema.json",
    "title": "hddc2b schema",
    "description": "Validate solver configurations for the hddc2b library",
    "type": "object",
    "properties": {
        "solvers": {
            "type": "array",
            "items": { "$ref": "#/$defs/solvers" }
        }
    },
    "required": [ "solvers" ],
    "$defs": {
        "identifier": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "solvers": {
            "type": "object",
            "properties": {
                "name": { "$ref": "#/$defs/identifier" },
                "quantity": {
                    "type": "string",
                    "enum": [ "force", "velocity" ]
                },
                "direction": {
                    "type": "string",
                    "enum": [ "composition", "distribution" ]
                },
                "preprocess-platform-weight": {
                    "type": "boolean"
                },
                "preprocess-drive-weight": {
                    "type": "boolean"
                },
                "weight-in-platform-space": {
                    "type": "boolean"
                },
                "weight-in-drive-space": {
                    "type": "boolean"
                },
                "has-secondary-task": {
                    "type": "boolean"
                },
                "inverse": {
                    "type": "string",
                    "enum": [ "pseudoinverse", "damped-least-squares" ]
                },
                "alignment": {
                    "type": "string",
                    "enum": [ "none", "twist-relaxation" ]
                },
                "output": {
                    "type": "string",
                    "enum": [ "pivot", "hub" ]
                },
                "wheel-speed-limit": {
                    "type": "boolean"
                },
                "description": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            },
            "required": [ "name", "quantity", "description" ],
            "if": {
                "$comment": "Velocity distribution and force composition are unique maps without weighting, inverse or nullspace.",
                "anyOf": [
                    {
                        "properties": {
                            "quantity": { "const": "velocity" },
                            "direction": { "const": "distribution" }
                        },
                        "required": [ "direction" ]
                    },
                    {
                        "properties": {
                            "quantity": { "const": "force" },
                            "direction": { "const": "composition" }
                        },
                        "required": [ "direction" ]
                    }
                ]
            },
            "then": {
                "not": { "required": [ "has-secondary-task" ] }
            },
            "else": {
                "required": [
                    "preprocess-platform-weight",
                    "preprocess-drive-weight",
                    "weight-in-platform-space",
                    "weight-in-drive-space",
                    "has-secondary-task",
                    "inverse"
                ]
            },
            "allOf": [
                {
                    "$comment": "Alignment, output level and the wheel speed limit only apply to velocity distribution.",
                    "if": {
                        "properties": {
                            "quantity": { "const": "velocity" },
                            "direction": { "const": "distribution" }
                        },
                        "required": [ "direction" ]
                    },
                    "else": {
                        "not": {
                            "anyOf": [
                                { "required": [ "alignment" ] },
                                { "required": [ "output" ] },
                                { "required": [ "wheel-speed-limit" ] }
                            ]
                        }
                    }
                },
                {
                    "$comment": "Only the hub output produces the hub speeds to limit.",
                    "if": {
                        "properties": { "wheel-speed-limit": { "const": true } },
                        "required": [ "wheel-speed-limit" ]
                    },
                    "then": {
                        "properties": { "output": { "const": "hub" } },
                        "required": [ "output" ]
                    }
                }
            ]
        }
    }
}
