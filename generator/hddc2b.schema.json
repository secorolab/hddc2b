{
    "license": "https://github.com/aws/mit-0",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/product.schema.json",
    "title": "hddc2b schema",
    "description": "Validate solver configurations for the hddc2b library",
    "type": "object",
    "properties": {
        "solvers": {
            "type": "array",
            "items": { "$ref": "#/$defs/solvers" }
        }
    },
    "required": [ "solvers" ],
    "$defs": {
        "identifier": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
        },
        "solvers": {
            "type": "object",
            "properties": {
                "name": { "$ref": "#/$defs/identifier" },
                "quantity": {
                    "type": "string",
                    "enum": [ "force", "velocity" ]
                },
                "direction": {
                    "type": "string",
                    "enum": [
                        "composition",
                        "distribution"
                    ]
                },
                "preprocess-platform-weight": {
                    "type": "boolean"
                },
                "preprocess-drive-weight": {
                    "type": "boolean"
                },
                "weight-in-platform-space": {
                    "type": "boolean"
                },
                "weight-in-drive-space": {
                    "type": "boolean"
                },
                "has-secondary-task": {
                    "type": "boolean"
                },
                "inverse": {
                    "type": "string",
                    "enum": [ "pseudoinverse", "damped-least-squares" ]
                },
                "alignment": {
                    "type": "string",
                    "enum": [ "none", "twist-relaxation" ]
                },
                "output": {
                    "type": "string",
                    "enum": [ "pivot", "hub" ]
                },
                "wheel-speed-limit": {
                    "type": "boolean"
                },
                "description": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            },
            "required": [
                "name",
                "quantity",
                "description"
            ],
            "if": {
                "anyOf": [
                    {
                        "properties": {
                            "quantity": { "const": "velocity" },
                            "direction": { "const": "distribution" }
                        },
                        "required": [ "quantity", "direction" ]
                    },
                    {
                        "properties": {
                            "quantity": { "const": "force" },
                            "direction": { "const": "composition" }
                        },
                        "required": [ "quantity", "direction" ]
                    }
                ]
            },
            "then": {
                "comment": "Velocity distribution is a unique map without nullspace, force composition a plain sum; neither uses weighting, inverse or a secondary task.",
                "required": [ "name", "quantity", "direction", "description" ],
                "not": { "required": [ "has-secondary-task" ] }
            },
            "else": {
                "required": [
                    "preprocess-platform-weight",
                    "preprocess-drive-weight",
                    "weight-in-platform-space",
                    "weight-in-drive-space",
                    "has-secondary-task",
                    "inverse"
                ],
                "not": {
                    "anyOf": [
                        { "required": [ "alignment" ] },
                        { "required": [ "output" ] },
                        { "required": [ "wheel-speed-limit" ] }
                    ]
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "has-secondary-task": { "const": true }
                        },
                        "required": [ "has-secondary-task" ]
                    },
                    "then": {
                        "required": [
                            "preprocess-platform-weight",
                            "preprocess-drive-weight",
                            "weight-in-platform-space",
                            "weight-in-drive-space",
                            "inverse"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "wheel-speed-limit": { "const": true }
                        },
                        "required": [ "wheel-speed-limit" ]
                    },
                    "then": {
                        "comment": "The hub speeds are only available for hub-level output.",
                        "properties": {
                            "output": { "const": "hub" }
                        },
                        "required": [ "output" ]
                    }
                }
            ]
        }
    }
}
