{%- set ns.f_drv = "f_drv2" -%}
{%- endif %}
    hddc2b_pltf_frc_slv(num_drv, u, s_inv, vt, {{ns.f_pltf}}, {{ns.f_drv}});
{%- endmacro -%}


{%- macro pltf_frc_redu_wgh_fini(conf, ns) -%}
{%- if conf["weight-in-drive-space"] -%}
{%- if conf["has-secondary-task"] %}
    double f_drv3[num_drv * NUM_DRV_COORD];
{%- set f_drv_ = "f_drv3" -%}
{%- else -%}
{%- set f_drv_ = "f_drv" -%}
{%- endif %}
