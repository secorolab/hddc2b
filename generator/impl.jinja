{% endif %}const double *f_pltf,
{% if conf["weight-in-drive-space"] %}const double *{{pltf_frc_w_drv(conf)}},
{% endif %}{% if conf["has-secondary-task"] %}const double *f_drv_ref,
{% endif %}double *tau_whl
{%- endmacro -%}


{%- macro pltf_frc_pltf_to_whl(conf) -%}
void {{conf.name}}(
{{pltf_frc_pltf_to_whl_sig(conf) | indent(width=8, first=true)}})
{
    assert(num_drv >= 0);

    const int NUM_DRV_COORD  = 2;
    const int NUM_PLTF_COORD = 3;
    const int NUM_G_COORD    = NUM_PLTF_COORD * NUM_DRV_COORD;
    double f_drv[num_drv * NUM_DRV_COORD];
    {%- set ns = namespace(
                        g      = "g",
                        f_pltf = "f_pltf",
                        f_drv  = "f_drv") %}

{{ pltf_frc_w_pltf_sqrt(conf) -}}
{{- pltf_frc_w_drv_inv_sqrt(conf) -}}
{{- pltf_frc_sing_wgh(conf, ns) -}}
{{- pltf_frc_redu_ref_init(conf, ns) -}}
{{- pltf_frc_redu_wgh_init(conf, ns) -}}
{{- pltf_slv_dcmp_inv(conf, ns) -}}
{{- pltf_frc_slv(conf, ns) -}}
{{- pltf_frc_redu_wgh_fini(conf, ns) -}}
{{- pltf_frc_redu_ref_fini(conf, ns) }}

    double f_whl[num_drv * NUM_DRV_COORD];
    hddc2b_drv_frc_pvt_to_gnd(num_drv, whl_dst, cstr_off, f_drv, f_whl);
    hddc2b_whl_frc_gnd_to_hub(num_drv, whl_dia, f_whl, tau_whl);
}
{% endmacro -%}


{%- macro pltf_frc_whl_to_pltf(conf) -%}
void {{conf.name}}(
        int num_drv,
        const double *g,
        const double *whl_dia,
        const double *whl_dst,
        const double *cstr_off,
        const double *tau_whl,
        double *f_pltf)
{
    assert(num_drv >= 0);

    const int NUM_DRV_COORD = 2;
    double f_whl[num_drv * NUM_DRV_COORD];
    double f_drv[num_drv * NUM_DRV_COORD];

    hddc2b_whl_frc_hub_to_gnd(num_drv, whl_dia, tau_whl, f_whl);
    hddc2b_drv_frc_gnd_to_pvt(num_drv, whl_dst, cstr_off, f_whl, f_drv);
    hddc2b_pltf_frc_pvt_to_pltf(num_drv, g, f_drv, f_pltf);
}
{% endmacro -%}


{%- macro pltf_frc_drv_to_pltf(conf) -%}
void {{conf.name}}(
        int num_drv,
        const double *g,
        const double *f_drv,
        double *f_pltf)
{
    assert(num_drv >= 0);

    hddc2b_pltf_frc_pvt_to_pltf(num_drv, g, f_drv, f_pltf);
}
{% endmacro -%}




