#include <math.h>
{% for s in solvers -%}
{%- if s["quantity"] == "force" -%}
    {%- if s.direction|default("distribution") == "composition" %}

{{pltf_frc_drv_to_pltf(s)}}
    {%- else %}

{{pltf_frc_pltf_to_drv(s)}}
    {%- endif -%}
{%- elif s.direction|default("composition") == "distribution" and s["output"]|default("pivot") == "hub" %}

{{pltf_vel_pltf_to_whl(s)}}
{%- elif s.direction|default("composition") == "distribution" %}

{{pltf_vel_pltf_to_drv(s)}}
{%- else %}

{{pltf_vel_drv_to_pltf(s)}}
{%- endif -%}
{% endfor -%}
